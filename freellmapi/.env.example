# Copier ce fichier en .env puis remplir. Le fichier .env n'est jamais committé.

# --- Compte du tableau de bord (http://localhost:3001) ---
ADMIN_EMAIL=moi@example.com
ADMIN_PASSWORD=changez-moi-8-caracteres-min

# --- Modèle principal (facultatif) ---
# Votre modèle habituel, via n'importe quelle API compatible OpenAI
# (OpenAI, Mistral, DeepSeek, OpenRouter payant…). Il est essayé EN PREMIER.
# Dès qu'il répond "limite atteinte" (HTTP 429) ou tombe en erreur (5xx),
# FreeLLMAPI passe automatiquement au premier modèle gratuit disponible.
# Laissez vide pour n'utiliser que des modèles gratuits.
PRIMARY_BASE_URL=
PRIMARY_API_KEY=
PRIMARY_MODEL=

# --- Clés des fournisseurs gratuits (facultatif mais recommandé) ---
# Sans aucune clé, seuls les fournisseurs sans clé (Kilo, OVHcloud) servent
# de secours, avec des limites très basses. Chaque clé ajoutée élargit le pool.
GROQ_API_KEY=          # https://console.groq.com/keys
GEMINI_API_KEY=        # https://aistudio.google.com/apikey
OPENROUTER_API_KEY=    # https://openrouter.ai/keys
CEREBRAS_API_KEY=      # https://cloud.cerebras.ai
MISTRAL_API_KEY=       # https://console.mistral.ai/api-keys
GITHUB_MODELS_TOKEN=   # https://github.com/settings/tokens (GitHub Models)
